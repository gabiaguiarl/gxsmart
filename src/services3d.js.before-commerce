import { createMarketplace } from './marketplace-premium.js';
import * as THREE from 'three';
import { RoundedBoxGeometry } from 'three/examples/jsm/geometries/RoundedBoxGeometry.js';
import { gsap } from 'gsap';
import { bus } from './motion/bus.js';
import { createRenderer, createEnvironment, lightRig } from './scene.js';


// Services stage (Refinamento 5.0): one object per service, built procedurally from a
// small kit of shared geometries/materials (GX language: black chrome, dark satin,
// purple light). Objects are built lazily on first selection; changing service plays a
// choreographed exit/enter (parts drift apart → next object turns in → camera settles).

const PURPLE = 0x7809ac;
const ORDER = ['marketplace', 'commerce', 'live', 'marketing', 'website', 'social', 'video', 'design', 'traffic', 'landing'];

export function mountServices(container, { fallback = null, kinds = ORDER } = {}) {
  if (!container) return () => {};
  let renderer;
  try { renderer = createRenderer(1.5); } catch { return () => {}; }
  container.appendChild(renderer.domElement);
  const scene = new THREE.Scene();
  const disposables = [];
  const track = (x) => { disposables.push(x); return x; };
  scene.environment = track(createEnvironment(renderer));
  const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
  camera.position.set(0, 0.1, 8);
  const { key, violet, rim } = lightRig(scene);
  const stage = new THREE.Group(); scene.add(stage);

  // ── Shared kit ──
  const M = {
    chrome: track(new THREE.MeshPhysicalMaterial({ color: 0x0b0a0f, metalness: 1, roughness: 0.16, clearcoat: 1, clearcoatRoughness: 0.1, envMapIntensity: 1.8 })),
    satin: track(new THREE.MeshPhysicalMaterial({ color: 0x17141c, metalness: 0.65, roughness: 0.42, clearcoat: 0.6, clearcoatRoughness: 0.35, envMapIntensity: 1.2 })),
    purple: track(new THREE.MeshStandardMaterial({ color: PURPLE, emissive: PURPLE, emissiveIntensity: 0.85, metalness: 0.4, roughness: 0.3 })),
    purpleMetal: track(new THREE.MeshPhysicalMaterial({ color: 0x5a0a80, metalness: 0.9, roughness: 0.25, clearcoat: 1, emissive: 0x2a0440, emissiveIntensity: 0.6, envMapIntensity: 1.6 })),
    light: track(new THREE.MeshStandardMaterial({ color: 0xf1ecf6, roughness: 0.45, metalness: 0.05, emissive: 0x2a2530, emissiveIntensity: 0.4 })),
    glass: track(new THREE.MeshPhysicalMaterial({ color: 0x08060c, metalness: 0.2, roughness: 0.05, clearcoat: 1, envMapIntensity: 2.2 })),
  };
  const geoCache = new Map();
  const G = (key, make) => { if (!geoCache.has(key)) geoCache.set(key, track(make())); return geoCache.get(key); };
  const rbox = (w, h, d, r = 0.06) => G(`rb${w}-${h}-${d}-${r}`, () => new RoundedBoxGeometry(w, h, d, 4, r));
  const sphere = (r) => G(`sp${r}`, () => new THREE.SphereGeometry(r, 32, 20));
  const cyl = (rt, rb, h, seg = 48) => G(`cy${rt}-${rb}-${h}`, () => new THREE.CylinderGeometry(rt, rb, h, seg));
  const torus = (r, t, arc = Math.PI * 2) => G(`to${r}-${t}-${arc}`, () => new THREE.TorusGeometry(r, t, 16, 96, arc));
  const plane = (w, h) => G(`pl${w}-${h}`, () => new THREE.PlaneGeometry(w, h));
  const mesh = (geo, mat, parent, pos = [0, 0, 0], rot = [0, 0, 0]) => { const m = new THREE.Mesh(geo, mat); m.position.set(...pos); m.rotation.set(...rot); parent.add(m); return m; };

  // Canvas UI textures (crisp, cheap, one draw each).
  const canvasTex = (w, h, draw) => {
    const c = document.createElement('canvas'); c.width = w; c.height = h;
    const g = c.getContext('2d'); draw(g, w, h);
    const t = track(new THREE.CanvasTexture(c)); t.colorSpace = THREE.SRGBColorSpace; t.anisotropy = 4;
    return t;
  };
  const font = (px, weight = 500) => `${weight} ${px}px "Space Grotesk", Arial, sans-serif`;
  const rr = (g, x, y, w, h, r) => { g.beginPath(); g.roundRect(x, y, w, h, r); g.fill(); };
  const screenMat = (tex) => track(new THREE.MeshStandardMaterial({ map: tex, emissive: 0xffffff, emissiveMap: tex, emissiveIntensity: 0.55, roughness: 0.35, metalness: 0.1 }));
  const bg = (g, w, h) => { const gr = g.createLinearGradient(0, 0, w, h); gr.addColorStop(0, '#16091f'); gr.addColorStop(1, '#07050a'); g.fillStyle = gr; g.fillRect(0, 0, w, h); };

  // Each builder returns { group, parts:[Object3D], update(t,dt), camZ, accent }
  // `parts` animate in/out; `update` is the object's own loop while active.
  const builders = {
    marketplace() { return createMarketplace({Group:THREE.Group,Physical:THREE.MeshPhysicalMaterial,Basic:THREE.MeshBasicMaterial,mesh,rbox,plane,track,canvasTex,container,camera,isAlive:()=>alive}); },
    commerce() {
      const group = new THREE.Group(), parts = [];
      const bag = new THREE.Group(); group.add(bag); bag.position.set(-0.55, -0.15, 0);
      mesh(rbox(1.5, 1.7, 0.65, 0.07), M.satin, bag);
      mesh(rbox(1.52, 0.14, 0.67, 0.03), M.purpleMetal, bag, [0, 0.62, 0]);
      [-0.36, 0.36].forEach((x) => mesh(torus(0.3, 0.035, Math.PI), M.chrome, bag, [x, 0.85, 0.0]));
      const checkout = new THREE.Group(); group.add(checkout); checkout.position.set(1.05, 0.25, 0.55); checkout.rotation.y = -0.35;
      const tex = canvasTex(512, 380, (g, w, h) => {
        bg(g, w, h); g.fillStyle = '#fff'; g.font = font(30); g.fillText('Checkout', 34, 58);
        g.fillStyle = '#ffffff30'; rr(g, 34, 92, 444, 64, 12); g.fillStyle = '#b04de0'; rr(g, 50, 108, 32, 32, 8);
        g.fillStyle = '#fff'; g.font = font(22, 400); g.fillText('Produto selecionado', 98, 132);
        g.fillStyle = '#ffffff99'; g.fillText('Total', 34, 214); g.fillStyle = '#fff'; g.font = font(30); g.fillText('R$ •••', 360, 216);
        g.fillStyle = '#7809ac'; rr(g, 34, 258, 444, 80, 16); g.fillStyle = '#fff'; g.font = font(26); g.fillText('FINALIZAR COMPRA', 136, 308);
      });
      mesh(rbox(1.5, 1.12, 0.06, 0.05), M.chrome, checkout);
      mesh(plane(1.4, 1.03), screenMat(tex), checkout, [0, 0, 0.032]);
      const card = new THREE.Group(); group.add(card); card.position.set(0.55, -0.85, 0.9);
      mesh(rbox(0.75, 0.48, 0.04, 0.05), M.purpleMetal, card); mesh(plane(0.18, 0.13), M.light, card, [-0.2, 0.06, 0.025]);
      const coin = mesh(cyl(0.18, 0.18, 0.05), M.chrome, group, [1.65, -0.65, 0.4], [Math.PI / 2, 0, 0]);
      parts.push(bag, checkout, card, coin); parts.forEach((p) => { p.userData.home = p.position.clone(); });
      return { group, parts, camZ: 7.6, accent: 1.1, update(t) { bag.rotation.y = Math.sin(t * 0.6) * 0.5 + t * 0.15; checkout.position.y = 0.25 + Math.sin(t * 1.1) * 0.05; card.rotation.z = Math.sin(t * 0.9) * 0.08; coin.rotation.z = t * 2; } };
    },
    live() {
      const group = new THREE.Group(), parts = [];
      const phone = new THREE.Group(); group.add(phone);
      const tex = canvasTex(400, 820, (g, w, h) => {
        bg(g, w, h); const gr = g.createRadialGradient(200, 330, 20, 200, 330, 300); gr.addColorStop(0, '#7809ac88'); gr.addColorStop(1, 'transparent'); g.fillStyle = gr; g.fillRect(0, 0, w, h);
        g.fillStyle = '#7809ac'; rr(g, 26, 34, 150, 46, 10); g.fillStyle = '#fff'; g.font = font(24); g.fillText('● AO VIVO', 42, 66);
        g.fillStyle = '#ffffff22'; rr(g, 246, 34, 128, 46, 10); g.fillStyle = '#fff'; g.font = font(20, 400); g.fillText('assistindo', 262, 64);
        g.fillStyle = '#ffffff18'; g.beginPath(); g.arc(200, 330, 120, 0, Math.PI * 2); g.fill();
        g.fillStyle = '#ffffff30'; rr(g, 26, 560, 250, 40, 20); rr(g, 26, 612, 300, 40, 20);
        g.fillStyle = '#fff'; rr(g, 26, 680, 348, 96, 18); g.fillStyle = '#7809ac'; rr(g, 42, 696, 64, 64, 12);
        g.fillStyle = '#111'; g.font = font(24); g.fillText('Produto da live', 124, 724); g.fillStyle = '#7809ac'; g.font = font(22); g.fillText('COMPRAR AGORA', 124, 756);
      });
      mesh(rbox(1.15, 2.3, 0.12, 0.14), M.chrome, phone);
      mesh(plane(1.03, 2.12), screenMat(tex), phone, [0, 0, 0.062]);
      const dot = mesh(sphere(0.03), M.purple, phone, [-0.38, 0.92, 0.09]);
      const ring = mesh(torus(0.55, 0.03), M.purpleMetal, group, [-1.45, 0.55, -0.4], [0, 0.5, 0]); // ring light
      const camera = mesh(cyl(0.12, 0.14, 0.3), M.chrome, group, [-1.45, 0.55, -0.4], [Math.PI / 2, 0, 0.5]);
      const product = new THREE.Group(); group.add(product); product.position.set(1.25, -0.5, 0.5);
      mesh(cyl(0.22, 0.26, 0.7), M.satin, product); mesh(cyl(0.12, 0.12, 0.2), M.purpleMetal, product, [0, 0.45, 0]);
      const hearts = [0, 1, 2, 3].map((i) => mesh(sphere(0.07 + i * 0.01), i % 2 ? M.purple : M.purpleMetal, group, [0.75, -0.4, 0.4]));
      parts.push(phone, ring, camera, product, ...hearts); parts.forEach((p) => { p.userData.home = p.position.clone(); });
      return {
        group, parts, camZ: 7.8, accent: 1.3,
        update(t) {
          dot.scale.setScalar(1 + Math.sin(t * 6) * 0.35); phone.rotation.y = Math.sin(t * 0.5) * 0.18;
          product.rotation.y = t * 0.8; product.position.y = -0.5 + Math.sin(t * 1.2) * 0.06;
          hearts.forEach((h, i) => { const p = (t * 0.35 + i / 4) % 1; h.position.set(0.75 + Math.sin(p * 6 + i) * 0.18, -0.4 + p * 2.2, 0.4); h.scale.setScalar(Math.sin(p * Math.PI)); });
        },
      };
    },
    marketing() {
      const group = new THREE.Group(), parts = [];
      const base = mesh(rbox(3.4, 0.1, 1.4, 0.04), M.chrome, group, [0, -1.2, 0]); parts.push(base);
      const heights = [0.6, 1.0, 0.8, 1.5, 2.1];
      const bars = heights.map((h, i) => {
        const g = G(`bar${h}`, () => new RoundedBoxGeometry(0.42, h, 0.42, 3, 0.04).translate(0, h / 2, 0));
        const m = mesh(g, i === 4 ? M.purpleMetal : M.satin, group, [-1.3 + i * 0.65, -1.15, 0]); parts.push(m); return m;
      });
      const pts = heights.map((h, i) => new THREE.Vector3(-1.3 + i * 0.65, -1.15 + h + 0.35, 0.35));
      const curve = new THREE.CatmullRomCurve3(pts);
      const tube = track(new THREE.TubeGeometry(curve, 120, 0.022, 8));
      const line = mesh(tube, M.purple, group); parts.push(line);
      const nodes = pts.map((p) => { const n = mesh(sphere(0.06), M.purple, group, [p.x, p.y, p.z]); parts.push(n); return n; });
      const target = mesh(torus(0.32, 0.03), M.chrome, group, [1.6, 1.1, 0.2]); parts.push(target);
      const target2 = mesh(torus(0.18, 0.03), M.purpleMetal, group, [1.6, 1.1, 0.2]); parts.push(target2);
      parts.forEach((p) => { p.userData.home = p.position.clone(); });
      const total = tube.index.count;
      return {
        group, parts, camZ: 8, accent: 1,
        enter(tl) { bars.forEach((b, i) => tl.fromTo(b.scale, { y: 0.02 }, { y: 1, duration: 0.45, ease: 'power3.out' }, 0.08 + i * 0.04)); const draw = { v: 0 }; tube.setDrawRange(0, 0); tl.to(draw, { v: 1, duration: 0.55, ease: 'power2.inOut', onUpdate: () => tube.setDrawRange(0, Math.floor((draw.v * total) / 3) * 3) }, 0.2); },
        update(t) { nodes.forEach((n, i) => n.scale.setScalar(1 + Math.sin(t * 3 + i) * 0.2)); target.rotation.y = t * 0.8; target2.rotation.x = t * 1.1; },
      };
    },
    website() {
      const group = new THREE.Group(), parts = [];
      const tex = canvasTex(820, 520, (g, w, h) => {
        bg(g, w, h); g.fillStyle = '#ffffff20'; rr(g, 40, 30, 740, 40, 10);
        g.fillStyle = '#fff'; g.font = font(54); g.fillText('Sua marca', 60, 170); g.fillText('no próximo nível.', 60, 230);
        g.fillStyle = '#ffffff66'; rr(g, 60, 262, 360, 14, 7); rr(g, 60, 288, 280, 14, 7);
        g.fillStyle = '#7809ac'; rr(g, 60, 330, 210, 56, 12); g.fillStyle = '#fff'; g.font = font(22); g.fillText('VAMOS CONVERSAR', 78, 365);
        const gr = g.createLinearGradient(480, 110, 760, 400); gr.addColorStop(0, '#7809ac'); gr.addColorStop(1, '#2a0a3d'); g.fillStyle = gr; rr(g, 490, 110, 270, 290, 24);
      });
      const frame = new THREE.Group(); group.add(frame);
      mesh(rbox(3, 2, 0.08, 0.06), M.chrome, frame);
      mesh(plane(2.9, 1.84), screenMat(tex), frame, [0, -0.04, 0.042]);
      [-1.36, -1.26, -1.16].forEach((x) => mesh(sphere(0.025), M.light, frame, [x, 0.92, 0.05]));
      const layer = (w, h, mat, pos) => { const m = mesh(rbox(w, h, 0.05, 0.04), mat, group, pos); parts.push(m); return m; };
      const l1 = layer(1.05, 0.7, M.purpleMetal, [0.95, -0.55, 0.45]);
      const l2 = layer(0.8, 0.22, M.satin, [-1.05, -0.75, 0.75]);
      const l3 = layer(0.5, 0.5, M.chrome, [1.45, 0.65, 0.9]);
      parts.unshift(frame); parts.forEach((p) => { p.userData.home = p.position.clone(); });
      return { group, parts, camZ: 7.6, accent: 1, layerZ: true, update(t) { [l1, l2, l3].forEach((l, i) => { l.position.y = l.userData.home.y + Math.sin(t * 1.1 + i * 2) * 0.05; }); group.rotation.x = -0.05; } };
    },
    social() {
      const group = new THREE.Group(), parts = [];
      const tex = canvasTex(400, 820, (g, w, h) => {
        bg(g, w, h); g.fillStyle = '#fff'; g.font = font(30); g.fillText('gxsmart', 30, 66);
        [130, 470].forEach((y, i) => { const gr = g.createLinearGradient(0, y, w, y + 280); gr.addColorStop(0, i ? '#2a0a3d' : '#7809ac'); gr.addColorStop(1, i ? '#7809ac' : '#16091f'); g.fillStyle = gr; rr(g, 26, y, 348, 270, 18); g.fillStyle = '#ffffff40'; rr(g, 26, y + 286, 200, 16, 8); });
      });
      const phone = new THREE.Group(); group.add(phone);
      mesh(rbox(1.15, 2.3, 0.12, 0.14), M.chrome, phone);
      mesh(plane(1.03, 2.12), screenMat(tex), phone, [0, 0, 0.062]);
      const postTex = [0, 1, 2].map((i) => canvasTex(300, 340, (g, w, h) => {
        g.fillStyle = '#f4f1f7'; g.fillRect(0, 0, w, h);
        const gr = g.createLinearGradient(0, 0, w, 240); gr.addColorStop(0, ['#7809ac', '#2a0a3d', '#a128dc'][i]); gr.addColorStop(1, '#0b0610'); g.fillStyle = gr; g.fillRect(14, 14, w - 28, 230);
        g.fillStyle = '#7809ac'; g.font = font(28); g.fillText(['♥ 248', '♥ 1.1k', '♥ 532'][i], 20, 290); g.fillStyle = '#0b061055'; rr(g, 20, 306, 180, 12, 6);
      }));
      const posts = postTex.map((tx) => { const p = new THREE.Group(); p.scale.setScalar(0.001); group.add(p); mesh(rbox(0.9, 1.02, 0.03, 0.05), M.chrome, p); mesh(plane(0.84, 0.95), screenMat(tx), p, [0, 0, 0.017]); parts.push(p); return p; });
      parts.unshift(phone); parts.forEach((p) => { p.userData.home = p.position.clone(); });
      return {
        group, parts, camZ: 8, accent: 1.1, noScatter: posts,
        update(t) {
          phone.rotation.y = -0.2 + Math.sin(t * 0.4) * 0.15;
          // Posts enter from the right, pass in front of the phone and leave to the left.
          posts.forEach((p, i) => {
            const k = ((t * 0.16 + i / 3) % 1), s = Math.sin(k * Math.PI);
            p.position.set(2.4 - k * 4.8, 0.55 - i * 0.45 + Math.sin(k * Math.PI * 2) * 0.2, 0.5 + s * 0.9);
            p.rotation.y = 0.6 - k * 1.2; p.scale.setScalar(0.25 + s * 0.85);
          });
        },
      };
    },
    video() {
      const group = new THREE.Group(), parts = [];
      const cam = new THREE.Group(); group.add(cam); cam.position.set(-0.2, -0.1, 0);
      mesh(rbox(1.7, 1.05, 0.95, 0.08), M.satin, cam);
      mesh(rbox(0.9, 0.12, 0.5, 0.04), M.chrome, cam, [0, 0.64, 0]); mesh(rbox(0.12, 0.34, 0.12, 0.03), M.chrome, cam, [-0.4, 0.48, 0]);
      const lens = new THREE.Group(); cam.add(lens); lens.position.set(1.1, -0.02, 0); lens.rotation.z = Math.PI / 2;
      mesh(cyl(0.36, 0.36, 0.5), M.chrome, lens); const focus = mesh(cyl(0.4, 0.4, 0.14, 24), M.purpleMetal, lens, [0, -0.08, 0]);
      mesh(cyl(0.3, 0.34, 0.08), M.glass, lens, [0, -0.29, 0]);
      mesh(rbox(0.45, 0.32, 0.06, 0.03), M.chrome, cam, [-0.6, 0.15, 0.5]); // monitor
      const rec = mesh(sphere(0.045), M.purple, cam, [0.6, 0.35, 0.48]);
      const playShape = new THREE.Shape([new THREE.Vector2(-0.12, -0.15), new THREE.Vector2(0.17, 0), new THREE.Vector2(-0.12, 0.15)]);
      const playGeo = G('play', () => new THREE.ExtrudeGeometry(playShape, { depth: 0.05, bevelEnabled: true, bevelThickness: 0.015, bevelSize: 0.012, bevelSegments: 2 }));
      const frames = [0, 1, 2].map((i) => { const f = new THREE.Group(); f.scale.setScalar(0.001); group.add(f); mesh(rbox(0.75, 0.5, 0.04, 0.04), i === 1 ? M.purpleMetal : M.chrome, f); mesh(playGeo, M.light, f, [0, 0, 0.03]); parts.push(f); return f; });
      parts.unshift(cam); parts.forEach((p) => { p.userData.home = p.position.clone(); });
      return {
        group, parts, camZ: 8, accent: 1, noScatter: frames,
        update(t) {
          focus.rotation.y = Math.sin(t * 0.8) * 1.2; rec.scale.setScalar(1 + Math.sin(t * 5) * 0.3); cam.rotation.y = -0.35 + Math.sin(t * 0.4) * 0.12;
          frames.forEach((f, i) => { const k = (t * 0.12 + i / 3) % 1; f.position.set(1.9 - k * 0.6, 1.3 - k * 2.8, -0.4 + Math.sin(k * Math.PI) * 0.6); f.rotation.set(0, -0.4, 0.15); f.scale.setScalar(Math.sin(k * Math.PI)); });
        },
      };
    },
    design() {
      const group = new THREE.Group(), parts = [];
      const tex = canvasTex(512, 512, (g, w, h) => { g.fillStyle = '#f4f1f7'; g.fillRect(0, 0, w, h); g.fillStyle = '#050505'; g.font = font(250, 600); g.fillText('Aa', 70, 330); g.fillStyle = '#7809ac'; g.fillRect(70, 380, 200, 14); g.fillStyle = '#05050566'; g.font = font(34); g.fillText('FORMA + FUNÇÃO', 70, 450); });
      const card = mesh(rbox(1.3, 1.3, 0.05, 0.05), M.chrome, group, [-0.75, 0.2, 0], [0, 0.25, -0.06]);
      mesh(plane(1.22, 1.22), screenMat(tex), card, [0, 0, 0.027]);
      const s = mesh(sphere(0.42), M.chrome, group, [0.75, 0.75, 0.3]);
      const t1 = mesh(torus(0.38, 0.11), M.purpleMetal, group, [1.0, -0.45, 0.2], [0.9, 0.3, 0]);
      const cone = mesh(G('cone', () => new THREE.ConeGeometry(0.34, 0.75, 48)), M.satin, group, [0.05, -0.85, 0.7]);
      const cube = mesh(rbox(0.5, 0.5, 0.5, 0.06), M.purple, group, [-1.55, -0.75, 0.5], [0.4, 0.6, 0]);
      const ring = mesh(torus(1.35, 0.008), M.purple, group, [0, 0, -0.3], [0, 0, 0]);
      parts.push(card, s, t1, cone, cube, ring); parts.forEach((p) => { p.userData.home = p.position.clone(); p.userData.rot = p.rotation.clone(); });
      return {
        group, parts, camZ: 7.6, accent: 1, scatterFar: true,
        update(t) { t1.rotation.y = t * 0.6; cube.rotation.y = 0.6 + t * 0.4; s.position.y = 0.75 + Math.sin(t) * 0.06; ring.rotation.x = Math.sin(t * 0.3) * 0.4; },
      };
    },
    traffic() {
      const group = new THREE.Group(), parts = [];
      const rings = [1.25, 0.95, 0.68, 0.42].map((r, i) => { const m = mesh(torus(r, 0.03), i % 2 ? M.purpleMetal : M.chrome, group, [0, 1.0 - i * 0.55, 0], [Math.PI / 2, 0, 0]); parts.push(m); return m; });
      const target = mesh(cyl(0.38, 0.38, 0.08), M.purple, group, [0, -1.35, 0]); parts.push(target);
      const arrowShape = new THREE.Shape([new THREE.Vector2(-0.12, -0.35), new THREE.Vector2(0.12, -0.35), new THREE.Vector2(0.12, 0.05), new THREE.Vector2(0.28, 0.05), new THREE.Vector2(0, 0.38), new THREE.Vector2(-0.28, 0.05), new THREE.Vector2(-0.12, 0.05)]);
      const arrow = mesh(G('arrow', () => new THREE.ExtrudeGeometry(arrowShape, { depth: 0.12, bevelEnabled: true, bevelThickness: 0.02, bevelSize: 0.02, bevelSegments: 2 })), M.chrome, group, [1.55, -0.3, 0]); parts.push(arrow);
      const N = 140, pos = new Float32Array(N * 3), seeds = Float32Array.from({ length: N }, () => Math.random());
      const pg = track(new THREE.BufferGeometry()); pg.setAttribute('position', new THREE.BufferAttribute(pos, 3));
      const pm = track(new THREE.PointsMaterial({ color: 0xc77dff, size: 0.05, transparent: true, opacity: 0.9, depthWrite: false, blending: THREE.AdditiveBlending }));
      const flow = new THREE.Points(pg, pm); group.add(flow); parts.push(flow);
      parts.forEach((p) => { p.userData.home = p.position.clone(); });
      return {
        group, parts, camZ: 8, accent: 1.1,
        update(t) {
          // Visitors flow down the funnel and converge on the target.
